"UnlitGeneric"
{
	"$basetexture" "Effects/Combineshield/comshieldwall"

	"$translucent" "1"
	"$additive" "1"
	"$alpharesult" "1"
	"$nodecal" "1"
    
	// Strong orange base color
    "$color" "{220 112 0}"

	"$envmap" "env_cubemap"
    "$envmaptint" "[0 0 0]"

	"Proxies"
	{
    	Sine
		{
			resultVar		$alpha // The shader parameter to be manipulated
			sineperiod		1
			sinemin			0.2
			sinemax			0.3
		}
		"TextureScroll"
		{
			"texturescrollvar" "$basetexturetransform"
			"texturescrollrate" .1
			"texturescrollangle" 20
		}
	}
}
